{
  "name": "empty-room",
  "version": "1.0.1",
  "description": "Smart screen lock that automatically secures your computer when you walk away.",
  "main": "./bin/empty-room.js",
  "bin": {
    "empty-room": "bin/empty-room.js"
  },
  "scripts": {
    "start": "node ./bin/empty-room.js run",
    "configure": "node ./bin/empty-room.js configure run",
    "stop": "node ./bin/empty-room.js stop",
    "test": "python -m unittest discover -s tests"
  },
  "keywords": [
    "smart-screen-lock",
    "auto-lock",
    "presence-lock",
    "computer-vision",
    "face-recognition",
    "security"
  ],
  "author": "Empty Room Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tech-no-guy/empty-room.git"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "bin",
    "core",
    "data",
    "assets",
    "requirements.txt",
    "install.ps1",
    "install.sh",
    "README.md",
    "LICENSE"
  ]
}
