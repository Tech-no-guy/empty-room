{
  "name": "empty-room",
  "version": "1.0.0",
  "description": "Enterprise workstation presence detection and auto-lock sentinel.",
  "main": "./bin/empty-room.js",
  "bin": {
    "empty-room": "./bin/empty-room.js"
  },
  "scripts": {
    "start": "node ./bin/empty-room.js run",
    "configure": "node ./bin/empty-room.js configure run",
    "stop": "node ./bin/empty-room.js stop",
    "test": "python -m unittest discover -s tests"
  },
  "keywords": [
    "presence-detection",
    "workstation-security",
    "auto-lock",
    "computer-vision",
    "face-recognition",
    "enterprise-security",
    "sentinel"
  ],
