  "repository": {
    "type": "git",
    "url": "https://github.com/empty-room/empty-room.git"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "bin",
    "empty_room",
    "data",
    "assets",
    "requirements.txt",
    "install.ps1",
    "install.sh",
    "README.md",
    "LICENSE"
  ]
}
